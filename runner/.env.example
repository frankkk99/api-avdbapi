AVDB_BASE_URL=https://avdbapi.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=keep-this-on-the-runner-only
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=keep-this-on-the-runner-only
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# Set PAGE to import exactly one AVDB page (recommended).
PAGE=1
# Optional batch mode: leave PAGE empty and set START_PAGE/END_PAGE.
# START_PAGE=1
# END_PAGE=10262
PAGE_DELAY_MS=1200
API_CONCURRENCY=6
# Set this when resuming an existing Admin-created run.
# RUN_ID=00000000-0000-0000-0000-000000000000
HEADLESS=false
PAGE_RETRY_COUNT=3
PAGE_403_WAIT_MS=10000
HUMAN_VERIFICATION_WAIT_MS=600000
MAX_CONSECUTIVE_403=5
# Optional: reuse a Chrome profile/session directory.
# CHROME_USER_DATA_DIR=C:\\Users\\YourName\\AppData\\Local\\Google\\Chrome\\User Data
